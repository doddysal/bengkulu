{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "*.webmanifest",
          "admin/**",
          "akun/**",
          "assets/**",
          "js/**",
          "kebijakan/**",
          "konten/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.js"
    }
  ]
}