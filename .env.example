# Salin menjadi .env. Aplikasi hanya membaca .env, bukan .env.example.
PORT=3000
NODE_ENV=development
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=ISI_ANON_ATAU_PUBLISHABLE_KEY
# Hanya untuk endpoint server tepercaya. Jangan pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pmi-bengkulu
MAX_UPLOAD_MB=3
ADMIN_TEST_EMAIL=admin.testing@pmibengkulu.test
ADMIN_TEST_PASSWORD=AdminTest#2026

# Connection string PostgreSQL untuk npm run db:push (gunakan Session Pooler bila jaringan tidak mendukung IPv6)
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD_DATABASE@HOST_POOLER:5432/postgres

CLOUDINARY_UPLOAD_PRESET=pmi_bengkulu_unsigned
